# ─────────────────────────────────────────────────────────────────────────────
# Online Safety Guard — environment variables
# Copy to .env (or .env.local) and fill in what you have. Nothing is required
# to boot: missing keys switch the corresponding capability off gracefully.
# ─────────────────────────────────────────────────────────────────────────────

# GEMINI_API_KEY: Required for AI capabilities (natural-language understanding,
# screenshot reading, social-engineering profiling, conversation narrative,
# personalised protection plans, coach scenarios, dashboard summary).
# Without it the app runs in deterministic mode (rules + external checks only).
# AI Studio injects this automatically from user secrets.
GEMINI_API_KEY=""

# Optional: override the model (default gemini-3.8-flash).
# GEMINI_MODEL="gemini-3.8-flash"

# Optional: route Gemini traffic through a proxy / local mock (leave unset normally).
# GEMINI_BASE_URL=""

# Optional: per-call AI timeouts in milliseconds.
# GEMINI_TIMEOUT_MS=25000
# GEMINI_VISION_TIMEOUT_MS=35000

# ── Threat intelligence (all optional; each source reports "not configured" when absent)
# RDAP (domain registration/age) and DNS lookups need no key and are always on.
VIRUSTOTAL_API_KEY=""
GOOGLE_SAFE_BROWSING_API_KEY=""
URLSCAN_API_KEY=""
ABUSEIPDB_API_KEY=""

# Optional: external lookup timeout in milliseconds (default 7000).
# INTEL_TIMEOUT_MS=7000

# Optional: per-IP request limit for investigation endpoints (default 30/minute).
# RATE_LIMIT_PER_MINUTE=30

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: HTTP port (default 3000).
# PORT=3000

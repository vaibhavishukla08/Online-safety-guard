# ─────────────────────────────────────────────────────────────────────────────
# Online Safety Guard — environment variables
# Copy to .env (or .env.local) and fill in what you have. Nothing is required
# to boot: missing keys switch the corresponding capability off gracefully and
# the UI says so. Never commit real values; .env* is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI ────────────────────────────────────────────────────────────────────────
# Required for AI capabilities (natural-language understanding, screenshot
# reading, social-engineering profiling, personalised plans, coach, summaries).
# Without it the app runs in deterministic mode (rules + external checks only)
# and every result is labelled "Rule-based fallback".
GEMINI_API_KEY=

# Optional: override the model (default gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash
# Optional: route Gemini traffic through a proxy / local mock (leave unset normally).
# GEMINI_BASE_URL=
# Optional: per-call AI timeouts in milliseconds.
# GEMINI_TIMEOUT_MS=25000
# GEMINI_VISION_TIMEOUT_MS=35000

# ── Threat intelligence (all optional; each source reports "not configured" when absent)
# RDAP (domain registration/age) and DNS lookups need no key and are always on.
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
URLSCAN_API_KEY=
ABUSEIPDB_API_KEY=
# Optional: external lookup timeout in milliseconds (default 7000).
# INTEL_TIMEOUT_MS=7000

# ── Application ───────────────────────────────────────────────────────────────
# Public HTTPS origin of this deployment, no trailing slash. Used to build the
# OAuth redirect URIs (…/api/connections/outlook/callback and …/gmail/callback).
# On Render this can be left empty: RENDER_EXTERNAL_URL is used automatically.
APP_BASE_URL=https://online-safety-guard.onrender.com

# Long random string (>= 16 chars) that protects sessions and derives the key
# used to encrypt stored mailbox tokens. REQUIRED in production — without it an
# ephemeral secret is generated and every restart signs everyone out and
# invalidates stored Outlook/Gmail connections.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional: separate key for encrypting OAuth tokens at rest (defaults to SESSION_SECRET).
# TOKEN_ENCRYPTION_KEY=

# Comma-separated emails that receive the ADMIN role on sign-up / next sign-in.
ADMIN_EMAILS=

# Optional: session lifetime in hours (default 168 = 7 days).
# SESSION_TTL_HOURS=168

# ── Database ──────────────────────────────────────────────────────────────────
# Production: a PostgreSQL connection string (Render → New → PostgreSQL → Internal URL).
# When set, PostgreSQL is used; when empty, a local SQLite file is used.
DATABASE_URL=
# SQLite file used when DATABASE_URL is empty (default ./data/online-safety-guard.sqlite).
# DATABASE_FILE=./data/online-safety-guard.sqlite
# Set to "false" to disable TLS for a non-local PostgreSQL that does not use SSL.
# DATABASE_SSL=true

# ── Microsoft (Connect Outlook — Microsoft identity platform + Graph, delegated Mail.Read)
# Azure portal → App registrations → New registration
#   Supported account types: "Accounts in any organizational directory and personal Microsoft accounts"
#   Redirect URI (Web): https://online-safety-guard.onrender.com/api/connections/outlook/callback
#   Certificates & secrets → New client secret → value below
#   API permissions (delegated): openid, profile, email, offline_access, User.Read, Mail.Read
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional: tenant id or "common" (default) / "organizations" / "consumers".
# MICROSOFT_TENANT=common

# ── Google (Connect Gmail — Google OAuth 2.0 + Gmail API, gmail.readonly)
# Google Cloud console → APIs & Services → enable "Gmail API"
#   OAuth consent screen: External, scopes openid, email, https://www.googleapis.com/auth/gmail.readonly
#   Credentials → OAuth client ID → Web application
#   Authorized redirect URI: https://online-safety-guard.onrender.com/api/connections/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Mailbox synchronisation (polling — there is no push channel) ─────────────
# Minutes between background syncs of every connected mailbox (0 = manual "Sync" only).
# SYNC_INTERVAL_MINUTES=15
# Newest messages fetched per sync (max 200).
# SYNC_MAX_MESSAGES=50
# Full (AI-backed) analyses spent automatically per sync run; the deterministic
# pre-filter picks the most suspicious candidates first.
# SYNC_AUTO_ANALYZE_MAX=5
# Pre-filter score (0-100) a message must reach to be analysed automatically.
# SYNC_AUTO_ANALYZE_THRESHOLD=20
# Vendor API timeout in milliseconds (Microsoft Graph / Gmail).
# PROVIDER_TIMEOUT_MS=15000

# ── Limits ────────────────────────────────────────────────────────────────────
# Per-IP request limit for investigation endpoints (default 30/minute).
# RATE_LIMIT_PER_MINUTE=30
# Per-IP sign-in / sign-up / link attempts per 15 minutes (default 20).
# AUTH_RATE_LIMIT=20

# ── Server ────────────────────────────────────────────────────────────────────
# PORT=3000
# NODE_ENV=production
# Local HTTPS for sideloading the Outlook add-in against a dev server (see README).
# HTTPS=true
# SSL_KEY_FILE=
# SSL_CERT_FILE=
